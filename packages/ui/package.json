{
	"name": "@modrinth/ui",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"main": "./index.ts",
	"types": "./index.ts",
	"sideEffects": [
		"**/*.css",
		"**/*.scss",
		"./src/utils/ace-theme.ts",
		"./src/utils/ace-mode-mcfunction.ts"
	],
	"imports": {
		"#ui/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		},
		"./pages": {
			"types": "./src/pages/index.ts",
			"default": "./src/pages/index.ts"
		},
		"./src/*": "./src/*"
	},
	"scripts": {
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write .",
		"intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/index.json --preserve-whitespace",
		"intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope packages/ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.18.0",
		"@modrinth/tooling-config": "workspace:*",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-themes": "^10.6.6",
		"@storybook/builder-vite": "^10.6.6",
		"@storybook/vue3-vite": "^10.6.6",
		"@tailwindcss/vite": "^4.3.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint-plugin-storybook": "^10.6.6",
		"storybook": "^10.6.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vite-svg-loader": "^5.1.3",
		"vue": "^3.5.45",
		"vue-component-type-helpers": "^3.3.14",
		"vue-router": "^5.4.0",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@modrinth/api-client": "^0.71.0",
		"@modrinth/assets": "workspace:*",
		"@modrinth/utils": "workspace:*",
		"@tanstack/vue-query": "5.101.4",
		"@tresjs/cientos": "^4.3.1",
		"@tresjs/core": "^4.3.6",
		"@tresjs/post-processing": "^2.4.0",
		"@types/markdown-it": "^14.2.0",
		"@types/three": "^0.172.0",
		"@vintl/how-ago": "^3.0.1",
		"@vueuse/core": "^15.0.0",
		"ace-builds": "^1.45.2",
		"apexcharts": "^8.7.0",
		"colord": "^2.10.0",
		"dayjs": "^1.11.23",
		"dompurify": "^3.4.17",
		"es-toolkit": "^1.53.2",
		"flatpickr": "^4.6.13",
		"floating-vue": "^5.4.0",
		"fuse.js": "^7.5.0",
		"highlight.js": "^11.12.0",
		"intl-messageformat": "^12.1.4",
		"jszip": "^3.10.2",
		"lru-cache": "^11.5.3",
		"markdown-it": "^15.0.3",
		"motion-v": "^2.11.1",
		"overlayscrollbars": "^2.17.0",
		"postprocessing": "^6.39.6",
		"qrcode.vue": "^3.11.0",
		"three": "^0.172.0",
		"vue-i18n": "^11.4.18",
		"vue-select": "4.0.0-beta.6",
		"vue-typed-virtual-list": "^1.0.10",
		"vue3-ace-editor": "^2.2.4",
		"vue3-apexcharts": "^1.11.3",
		"xss": "^1.0.17"
	},
	"web-types": "../../web-types.json"
}
